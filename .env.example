# Single shared application credential (security_nfr SEC-1). Never commit real values.
SHARED_USERNAME=demo
SHARED_PASSWORD=change-me

# Session cookie signing (security_nfr SEC-1/SEC-2). Never commit a real value.
SESSION_SECRET_KEY=change-me-too

# SQLite file path (relative to app working directory).
DATABASE_PATH=./data/conversational_crm.db

# Chroma persistent local directory (PLA-2: embedded/persistent-local, not networked).
CHROMA_PERSIST_DIR=./data/chroma

# NLU engine: "rule_based" (default, no cloud dependency, used for tests/local dev)
# or "bedrock" (real AWS Bedrock calls -- requires AWS credentials/region below).
NLU_ENGINE=rule_based

# Only used when NLU_ENGINE=bedrock.
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# F-4 AC2 due-soon window (PRD Open Question 6, carried-over placeholder).
DUE_SOON_WINDOW_DAYS=7

# F-8 AC2 top-N bound (PRD Open Question 16, carried-over placeholder -- Stories Open Item 6).
HOME_TOP_N=5

# security_nfr SEC-11: per-session request rate limit (requests per minute) on
# POST /interactions, POST /qa, POST /briefs.
RATE_LIMIT_PER_MINUTE=30

# security_nfr SEC-5: login lockout threshold / window.
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Comma-separated frontend origin(s) allowed to call this API cross-origin
# (e.g. your Vercel deployment URL). Leave empty for same-origin/local dev.
CORS_ALLOWED_ORIGINS=

# "strict" (default) for same-site deployments. Set to "none" when the
# frontend and backend are on different origins (e.g. Vercel + Render) --
# a Strict/Lax cookie is never sent on a cross-site request.
COOKIE_SAMESITE=strict
